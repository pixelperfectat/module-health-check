<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="PixelPerfect\HealthCheck\Model\Runner">
        <arguments>
            <argument name="checks" xsi:type="array"/>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="pixelperfect_healthcheck_check" xsi:type="object">PixelPerfect\HealthCheck\Console\Command\HealthCheckCommand</item>
            </argument>
        </arguments>
    </type>

</config>