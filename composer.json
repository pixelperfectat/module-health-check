{
    "name": "pixelperfectat/module-health-check",
    "description": "Pluggable post-deploy health-check framework for Magento 2",
    "type": "magento2-module",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Andre Flitsch",
            "email": "pixelhed@pixelperfect.at"
        }
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "pixelperfectat/coding-standard": "^0.1.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "PixelPerfect\\HealthCheck\\": "src"
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor .",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse",
        "test": "phpunit",
        "ci:validate": "@composer validate --no-check-publish",
        "check": [
            "@ci:validate",
            "@lint",
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ]
}
